{"_default": {"1": {"id": "9f0ef5dd-0a3d-4db4-811a-9c0c59688b80", "section": "Cell Types", "content": "\"S\": Starting position of the agent."}, "2": {"id": "8a52ab0e-ae9f-4b4a-ab0b-5ba19fe9a234", "section": "Cell Types", "content": "\"F\": Free or floor cell that the agent can traverse."}, "3": {"id": "c62ca6a6-e7f3-4521-8b2c-913fb88b190f", "section": "Cell Types", "content": "\"H\": Hazard or hole cell."}, "4": {"id": "2da8622c-6eb2-46ce-b97e-a90b19b9fda8", "section": "Cell Types", "content": "\"G\": Goal cell. Entering cell \"G\" terminates the navigation episode with success and grants reward 1."}}}